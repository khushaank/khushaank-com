SECRET_KEY=change-me-before-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Render + Supabase: copy the Session pooler URL from Supabase Connect, port 5432.
# Keep sslmode=require and percent-encode special characters in the password.
DATABASE_URL=postgresql://weblog:weblog@db:5432/weblog
SITE_URL=http://localhost:8000
TIME_ZONE=Asia/Kolkata
# Set USE_S3_MEDIA=True for Supabase Storage (or another S3-compatible service).
USE_S3_MEDIA=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
# Supabase example: https://PROJECT_REF.storage.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
# Public bucket URL without https://, e.g. PROJECT_REF.supabase.co/storage/v1/object/public/blog-media
MEDIA_CDN_DOMAIN=
# Production only. Startup creates this account once and never changes its password.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
